{
  "name": "pagetodotmd",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && bun scripts/publish-paths.ts",
    "test": "bun test",
    "lint": "eslint src tests",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "htmltodotmd": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "linkedom": "^0.18.12",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryushkin/dotmd-webcore.git",
    "directory": "packages/pagetodotmd"
  },
  "homepage": "https://github.com/andryushkin/dotmd-webcore",
  "license": "MIT",
  "description": "Reads a live page for htmltodotmd: computed style, shadow DOM, hard breaks, selection capture."
}
