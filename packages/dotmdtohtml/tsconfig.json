{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `DOM` because the second half of a render writes into an element the
    // caller hands in, and `DOM.Iterable` because a `NodeList` of placeholders
    // is walked directly. No `DOM` type is ever *constructed* here — the
    // document arrives as an argument.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": ["src", "tests"]
}
